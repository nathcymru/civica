<%
  # Four-nation adult reading infographic for /content/writing-guidelines/clear-language.html.
  # Real published figures; provenance and URLs are on /community/sources.html.
  # Colours come only from design-system/chart-colours.json ids (categorical "blue",
  # labels.light "black", paper "white"), resolved through govuk_colour so no hex is typed here.
  # Each nation used its own survey, test and year, so panels share no axis and are not ranked.
  # The 1 in 28 row is drawn as 2 rows of 14 so each figure stays legible at 320px.
  # The table sits before the nation headings so the layout names its region after the section heading.
  # Output is built as one line of HTML so the Markdown renderer leaves it alone.
  hex = ->(id) { govuk_colour(id).fetch('hex') }
  blue, ink, paper = hex.('blue'), hex.('black'), hex.('white')

  # One person: round head, body with a rounded top and square base. No face.
  person = lambda do |x, y, filled|
    style = filled ? %(fill="#{blue}" stroke="#{blue}") : %(fill="#{paper}" stroke="#{ink}")
    %(<g transform="translate(#{x} #{y})" #{style} stroke-width="1.5"><circle cx="12" cy="8" r="6"/><path d="M3 42V25a9 9 0 0 1 18 0V42Z"/></g>)
  end

  # A pictogram of `total` people, `per_row` to a row, with the first one filled.
  pictogram = lambda do |total, per_row, scale|
    rows = (total.to_f / per_row).ceil
    width = per_row * 24
    height = rows * 48 - 4
    people = (0...total).map { |i| person.((i % per_row) * 24, (i / per_row) * 48, i.zero?) }
    %(<svg aria-hidden="true" focusable="false" viewBox="-1 -1 #{width + 2} #{height + 2}" style="display:block;width:100%;max-width:#{((width + 2) * scale).round}px;height:auto;margin:0 0 10px">#{people.join}</svg>)
  end

  link = docs_path('/community/sources.html')

  panels = [
    {
      nation: 'England', year: '2023',
      parts: [
        [6, 6, 1.25, '<strong>About 1 in 6 adults (18%)</strong> can find a fact in a short, simple text, but find it hard to read longer text with a lot of other detail.']
      ]
    },
    {
      nation: 'Northern Ireland', year: '2012',
      parts: [
        [6, 6, 1.25, '<strong>About 1 in 6 adults (18%)</strong> could manage short, simple texts but struggled with longer, detailed ones. In 1996 it was nearer 1 in 4 (23%).']
      ]
    },
    {
      nation: 'Wales', year: '2010',
      parts: [
        [8, 8, 1.25, '<strong>About 1 in 8 adults (12%)</strong> read and write English below the level needed for everyday life. In 2004 it was 25%.']
      ]
    },
    {
      nation: 'Scotland', year: '2009',
      parts: [
        [4, 4, 1.25, '<strong>Just over 1 in 4 adults (26.7%)</strong> may sometimes find reading and writing hard, but generally cope.'],
        [28, 14, 0.83, 'This includes <strong>about 1 in 28 adults (3.6%)</strong> who find reading and writing seriously hard.']
      ]
    }
  ]

  panel_html = panels.map do |panel|
    body = panel[:parts].map { |total, per_row, scale, text| pictogram.(total, per_row, scale) + %(<p class="govuk-body">#{text}</p>) }.join
    %(<div class="govuk-grid-column-one-half"><h3 class="govuk-heading-s">#{panel[:nation]}, #{panel[:year]}</h3>#{body}</div>)
  end

  table_rows = [
    ['England', '2023', '18% (about 1 in 6)', 'Can find a fact in a short, simple text, but finds it hard to read longer text with a lot of other detail.'],
    ['Northern Ireland', '2012', '18% (about 1 in 6)', 'Could manage short, simple texts but struggled with longer, detailed ones. In 1996 it was 23%.'],
    ['Wales', '2010', '12% (about 1 in 8)', 'Reads and writes English below the level needed for everyday life. In 2004 it was 25%.'],
    ['Scotland', '2009', '26.7% (just over 1 in 4), including 3.6% (about 1 in 28)', 'May sometimes find reading and writing hard, but generally copes. The 3.6% find reading and writing seriously hard.']
  ].map do |nation, year, share, meaning|
    %(<tr class="govuk-table__row"><th scope="row" class="govuk-table__header">#{nation}</th><td class="govuk-table__cell">#{year}</td><td class="govuk-table__cell">#{share}</td><td class="govuk-table__cell">#{meaning}</td></tr>)
  end

  html = %(<div class="c-colour-example"><figure style="margin:0 0 20px">) +
    %(<figcaption class="govuk-body"><strong>How many adults find reading hard, by nation</strong><br>Adults aged 16 to 65, from a national survey of adults in each nation.</figcaption>) +
    %(<details class="govuk-details"><summary class="govuk-details__summary"><span class="govuk-details__summary-text">Show the figures as a table</span></summary><div class="govuk-details__text"><div class="civica-table-scroll" role="region" tabindex="0" aria-label="Adults who find reading hard, by nation"><table class="govuk-table"><caption class="govuk-table__caption govuk-table__caption--s">Adults who find reading hard, by nation</caption><thead class="govuk-table__head"><tr class="govuk-table__row"><th scope="col" class="govuk-table__header">Nation</th><th scope="col" class="govuk-table__header">Year</th><th scope="col" class="govuk-table__header">Share of adults aged 16 to 65</th><th scope="col" class="govuk-table__header">What it means</th></tr></thead><tbody class="govuk-table__body">#{table_rows.join}</tbody></table></div></div></details>) +
    %(<div class="govuk-grid-row">#{panel_html[0]}#{panel_html[1]}</div>) +
    %(<div class="govuk-grid-row">#{panel_html[2]}#{panel_html[3]}</div>) +
    %(<p class="govuk-body-s">Each nation measured reading in its own survey and year, so do not compare the numbers between nations. <a class="govuk-link" href="#{link}">Sources</a></p>) +
    %(</figure></div>)
%><%= html %>
