<%
  # Adult reading infographic for /content/writing-guidelines/clear-language.html.
  # One 16:9 illustration, redrawn from Nathan's reference (23 Nov 2026): title, a nations
  # map, and four uniform cards (nation, large "1 in N", two short lines,
  # a centred row of people). Colours are Civica web palette colours chosen to match the
  # reference; each nation colour reaches 4.5:1 on white.
  # Figures are the verified ones on /community/sources.html, not the reference's.
  # Map outlines come from docs/data/uk-nations-map.json (Natural Earth, public domain),
  # generated by docs/scripts/generate-uk-nations-map.py; never hand-edit the paths.
  # The SVG is role="img" with a full text description; the table below repeats the figures.
  hex = ->(id) { govuk_colour(id).fetch('hex') }
  ink, white, paper, grey = hex.('black'), hex.('white'), hex.('black-tint-95'), hex.('black-tint-50')
  map = JSON.parse(File.read(File.join(root, 'data', 'uk-nations-map.json')))
  link = docs_path('/community/sources.html')

  nations = {
    'Scotland'         => { colour: hex.('magenta-shade-25'), n: 4, lines: ['adults in Scotland sometimes', 'find reading and writing hard'], x: 688,  y: 190 },
    'Northern Ireland' => { colour: hex.('orange-shade-25'),  n: 6, lines: ['adults in Northern Ireland', 'struggle with longer text'],     x: 1124, y: 190 },
    'Wales'            => { colour: hex.('green'),            n: 8, lines: ['adults in Wales lack everyday', 'reading and writing skills'], x: 688,  y: 522 },
    'England'          => { colour: hex.('blue-shade-50'),    n: 6, lines: ['adults in England struggle', 'with longer text'],              x: 1124, y: 522 }
  }
  card_w, card_h = 412, 304

  # One standing person: round head, body with arms, two legs. Flat, no face.
  person = lambda do |x, y, fill|
    %(<g transform="translate(#{x} #{y})" fill="#{fill}"><circle cx="14" cy="7" r="7"/><rect x="5" y="16" width="18" height="24" rx="6"/><rect x="0" y="17" width="5" height="20" rx="2.5"/><rect x="23" y="17" width="5" height="20" rx="2.5"/><rect x="6" y="38" width="7" height="22" rx="2"/><rect x="15" y="38" width="7" height="22" rx="2"/></g>)
  end

  card = lambda do |name, c|
    cx = c[:x] + card_w / 2
    row = c[:n] * 38 - 10
    people = (0...c[:n]).map { |i| person.(cx - row / 2 + i * 38, c[:y] + 222, i.zero? ? c[:colour] : grey) }.join
    %(<rect x="#{c[:x]}" y="#{c[:y]}" width="#{card_w}" height="#{card_h}" rx="16" fill="#{white}" stroke="#{c[:colour]}" stroke-width="6"/>) +
      %(<text x="#{cx}" y="#{c[:y] + 50}" text-anchor="middle" font-size="32" font-weight="700" fill="#{c[:colour]}">#{name.upcase}</text>) +
      %(<text x="#{cx}" y="#{c[:y] + 128}" text-anchor="middle" font-size="76" font-weight="700" fill="#{ink}">1 in #{c[:n]}</text>) +
      c[:lines].each_with_index.map { |line, i| %(<text x="#{cx}" y="#{c[:y] + 166 + i * 30}" text-anchor="middle" font-size="24" fill="#{ink}">#{line}</text>) }.join +
      people
  end

  # Map: 300 wide in its own units, scaled to sit left of the cards.
  scale = 1.22
  mx, my = 160, 152
  map_paths = ['Scotland', 'England', 'Wales', 'Northern Ireland'].map do |name|
    %(<path d="#{map['paths'].fetch(name)}" fill="#{nations[name][:colour]}"/>)
  end.join
  map_group = %(<g transform="translate(#{mx} #{my}) scale(#{scale})" stroke="#{white}" stroke-width="1.2" stroke-linejoin="round">#{map_paths}</g>)

  description = 'A map of the United Kingdom with each nation in its own colour, beside four cards. ' \
    'Scotland: 1 in 4 adults sometimes find reading and writing hard. ' \
    'Northern Ireland: 1 in 6 adults struggle with longer text. ' \
    'Wales: 1 in 8 adults lack everyday reading and writing skills. ' \
    'England: 1 in 6 adults struggle with longer text. ' \
    'Each nation measured reading in its own way, in a different year, from 2009 to 2023.'

  svg = %(<svg role="img" aria-labelledby="reading-title reading-desc" viewBox="0 0 1600 900" style="display:block;width:100%;height:auto;margin:0 0 15px;font-family:Roboto,Helvetica Neue,Helvetica,Arial,sans-serif">) +
    %(<title id="reading-title">Adult literacy in the UK</title><desc id="reading-desc">#{description}</desc>) +
    %(<g aria-hidden="true"><rect width="1600" height="900" fill="#{paper}"/>) +
    %(<text x="800" y="78" text-anchor="middle" font-size="60" font-weight="700" fill="#{ink}">Adult literacy in the UK</text>) +
    %(<text x="800" y="130" text-anchor="middle" font-size="28" fill="#{ink}">Adults aged 16 to 65 who find reading hard, from four national studies</text>) +
    map_group + nations.map { |name, c| card.(name, c) }.join +
    %(<text x="800" y="874" text-anchor="middle" font-size="20" fill="#{hex.('black-tint-25')}">Each nation measured reading in its own way, in a different year, from 2009 to 2023</text>) +
    %(</g></svg>)

  table_rows = [
    ['Scotland', '2009', '26.7% (just over 1 in 4), including 3.6% (about 1 in 28)', 'May sometimes find reading and writing hard, but generally copes. The 3.6% find reading and writing seriously hard.'],
    ['Northern Ireland', '2012', '18% (about 1 in 6)', 'Could manage short, simple texts but struggled with longer, detailed ones. In 1996 it was 23%.'],
    ['Wales', '2010', '12% (about 1 in 8)', 'Reads and writes English below the level needed for everyday life. In 2004 it was 25%.'],
    ['England', '2023', '18% (about 1 in 6)', 'Can find a fact in a short, simple text, but finds it hard to read longer text with a lot of other detail.']
  ].map do |nation, year, share, meaning|
    %(<tr class="govuk-table__row"><th scope="row" class="govuk-table__header">#{nation}</th><td class="govuk-table__cell">#{year}</td><td class="govuk-table__cell">#{share}</td><td class="govuk-table__cell">#{meaning}</td></tr>)
  end

  html = %(<figure style="margin:0 0 20px">#{svg}) +
    %(<details class="govuk-details"><summary class="govuk-details__summary"><span class="govuk-details__summary-text">Show the figures as a table</span></summary><div class="govuk-details__text"><div class="civica-table-scroll" role="region" tabindex="0" aria-label="Adults who find reading hard, by nation"><table class="govuk-table"><caption class="govuk-table__caption govuk-table__caption--s">Adults aged 16 to 65 who find reading hard, by nation</caption><thead class="govuk-table__head"><tr class="govuk-table__row"><th scope="col" class="govuk-table__header">Nation</th><th scope="col" class="govuk-table__header">Year</th><th scope="col" class="govuk-table__header">Share of adults</th><th scope="col" class="govuk-table__header">What it means</th></tr></thead><tbody class="govuk-table__body">#{table_rows.join}</tbody></table></div><p class="govuk-body-s">Do not compare the numbers between nations. <a class="govuk-link" href="#{link}">Sources</a></p></div></details>) +
    %(</figure>)
%><%= html %>
