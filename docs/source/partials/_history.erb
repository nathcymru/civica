<% history = page_history %>
<div class="c-history" aria-label="Page publication history">
  <p>Published <time datetime="<%= history[:published] %>"><%= readable_date(history[:published]) %></time><br>
  Last updated <time datetime="<%= history[:updated] %>"><%= readable_date(history[:updated]) %></time></p>
  <p class="c-history__edit"><svg class="c-history__edit-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25Zm17.71-10.21a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83Z"/></svg> <a class="govuk-link" target="_blank" rel="noopener noreferrer" href="https://github.com/nathcymru/civica/edit/main/<%= current_page.data.repository_source || ('docs/source/' + current_page.source_file.sub(root + '/source/', '')) %>">Edit this page<span class="govuk-visually-hidden"> on GitHub (opens in new tab)</span></a></p>
  <details id="full-publication-update-history"><summary>See all updates</summary>
    <ol><% history[:changes].each do |change| %><li><time datetime="<%= change['date'] %>"><%= readable_date(change['date']) %></time><p><%= escape(change['description']) %></p></li><% end %></ol>
  </details>
</div>
