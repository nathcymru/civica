<%# Footer layout: share links, page feedback, three link columns, then the identity line. Layout only follows the reference sites; the wording is civica's own. %>
<% address = page_address %>
<% prompt = "Read #{address} and help me understand how to apply it. It is guidance from the civica Design System for Home Assistant. Write in British English and state only what the page says." %>
<footer class="c-footer">
<div class="c-container">
<section class="c-footer__share" aria-labelledby="footer-share-heading">
<h2 id="footer-share-heading">Share this page</h2>
<p>These links open in a new tab. The last three start a conversation with an AI assistant that has the page address and an instruction to read it.</p>
<ul class="c-footer__share-list">
<li><a href="mailto:?subject=<%= encode_param(current_page.data.title.to_s) %>&amp;body=<%= encode_param(address) %>" target="_blank" rel="noopener noreferrer">Email<span class="govuk-visually-hidden"> this page (opens in a new tab)</span></a></li>
<li><a href="https://teams.microsoft.com/share?href=<%= encode_param(address) %>" target="_blank" rel="noopener noreferrer">Microsoft Teams<span class="govuk-visually-hidden"> (opens in a new tab)</span></a></li>
<li><a href="https://claude.ai/new?q=<%= encode_param(prompt) %>" target="_blank" rel="noopener noreferrer">Claude<span class="govuk-visually-hidden"> (opens in a new tab)</span></a></li>
<li><a href="https://chatgpt.com/codex?prompt=<%= encode_param(prompt) %>" target="_blank" rel="noopener noreferrer">Codex<span class="govuk-visually-hidden"> (opens in a new tab)</span></a></li>
<li><a href="https://chat.mistral.ai/chat?q=<%= encode_param(prompt) %>" target="_blank" rel="noopener noreferrer">Mistral AI<span class="govuk-visually-hidden"> (opens in a new tab)</span></a></li>
</ul>
</section>
<section class="c-footer__useful" aria-labelledby="footer-useful-heading" data-page-useful>
<h2 id="footer-useful-heading">Is this page useful?</h2>
<ul class="c-footer__useful-list">
<li><button type="button" class="c-footer__button" data-useful="yes" hidden>Yes <span class="govuk-visually-hidden">this page is useful</span></button></li>
<li><button type="button" class="c-footer__button" data-useful="no" hidden>No <span class="govuk-visually-hidden">this page is not useful</span></button></li>
<li><a class="c-footer__button c-footer__button--link" href="https://github.com/nathcymru/civica/issues/new?template=bug_report.yml&amp;page=<%= encode_param(address) %>" target="_blank" rel="noopener noreferrer">Report a problem with this page<span class="govuk-visually-hidden"> (opens GitHub in a new tab)</span></a></li>
</ul>
<p class="c-footer__useful-thanks" role="status" data-useful-status></p>
</section>
<nav class="c-footer__columns" aria-label="Footer links">
<div><h2>civica Design System</h2><ul>
<li><a href="<%= docs_path('/get-started/index.html') %>">Get started</a></li>
<li><a href="<%= docs_path('/styles/index.html') %>">Styles</a></li>
<li><a href="<%= docs_path('/components/index.html') %>">Components</a></li>
<li><a href="<%= docs_path('/patterns/index.html') %>">Patterns</a></li>
<li><a href="<%= docs_path('/accessibility/index.html') %>">Accessibility</a></li>
<li><a href="<%= docs_path('/sitemap.html') %>">Sitemap</a></li>
</ul></div>
<div><h2>Project</h2><ul>
<li><a href="https://github.com/nathcymru/civica">GitHub repository</a></li>
<li><a href="https://github.com/nathcymru/civica/issues/new?template=bug_report.yml">Report a bug</a></li>
<li><a href="https://github.com/nathcymru/civica/issues/new?template=roadmap_item.yml">Suggest a feature</a></li>
<li><a href="<%= docs_path('/community/licensing.html') %>">Licence and attribution</a></li>
<li><a href="<%= docs_path('/llms.txt') %>">AI reading guide</a></li>
</ul></div>
<div><h2>Home Assistant</h2><ul>
<li><a href="https://my.home-assistant.io/redirect/hacs_repository/?owner=nathcymru&amp;repository=civica&amp;category=theme">Install civica with HACS</a></li>
<li><a href="https://www.home-assistant.io/installation/">Download Home Assistant</a></li>
<li><a href="https://apps.apple.com/app/home-assistant/id1099568401">Companion app on the App Store</a></li>
<li><a href="https://play.google.com/store/apps/details?id=io.homeassistant.companion.android">Companion app on Google Play</a></li>
</ul></div>
</nav>
<div class="c-footer__identity"><img src="<%= docs_path('/images/civica-emblem.svg') %>" alt="" width="40" height="40"><p>civica is independent of the UK Government and uses open-source GOV.UK Frontend components; see <a href="<%= docs_path('/community/licensing.html') %>">Licence and attribution</a>.</p></div>
</div>
</footer>
