<%# Footer: the full footer component markup with civica's own links. %>
<footer class="gem-c-layout-footer govuk-footer">
<div class="govuk-width-container">
<img class="govuk-footer__crown" src="<%= docs_path('/images/civica-emblem.svg') %>" alt="" width="32" height="32">
<div class="govuk-footer__navigation">
<div class="govuk-grid-column-two-thirds govuk-!-display-none-print">
<h2 class="govuk-footer__heading govuk-heading-m">civica Design System</h2>
<ul class="govuk-footer__list govuk-footer__list--columns-2">
<% data.navigation.sections.each do |section| %><li class="govuk-footer__list-item"><a class="govuk-footer__link" href="<%= docs_path(section.path) %>"><%= section.title %></a></li>
<% end %></ul>
</div>
<div class="govuk-grid-column-one-third govuk-!-display-none-print">
<h2 class="govuk-footer__heading govuk-heading-m">Project</h2>
<ul class="govuk-footer__list govuk-footer__list--columns-1">
<li class="govuk-footer__list-item"><a class="govuk-footer__link" href="https://github.com/nathcymru/civica">GitHub repository</a></li>
<li class="govuk-footer__list-item"><a class="govuk-footer__link" href="https://github.com/nathcymru/civica/issues/new?template=bug_report.yml">Report a bug</a></li>
<li class="govuk-footer__list-item"><a class="govuk-footer__link" href="https://github.com/nathcymru/civica/issues/new?template=roadmap_item.yml">Suggest a feature</a></li>
<li class="govuk-footer__list-item"><a class="govuk-footer__link" href="<%= docs_path('/llms.txt') %>">AI reading guide</a></li>
</ul>
<h2 class="govuk-footer__heading govuk-heading-m">Home Assistant</h2>
<ul class="govuk-footer__list govuk-footer__list--columns-1">
<li class="govuk-footer__list-item"><a class="govuk-footer__link" href="https://my.home-assistant.io/redirect/hacs_repository/?owner=nathcymru&amp;repository=civica&amp;category=theme">Install civica with HACS</a></li>
<li class="govuk-footer__list-item"><a class="govuk-footer__link" href="https://www.home-assistant.io/installation/">Download Home Assistant</a></li>
<li class="govuk-footer__list-item"><a class="govuk-footer__link" href="https://apps.apple.com/app/home-assistant/id1099568401">Companion app on the App Store</a></li>
<li class="govuk-footer__list-item"><a class="govuk-footer__link" href="https://play.google.com/store/apps/details?id=io.homeassistant.companion.android">Companion app on Google Play</a></li>
</ul>
</div>
</div>
<hr class="govuk-footer__section-break govuk-!-display-none-print">
<div class="govuk-footer__meta">
<div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
<h2 class="govuk-visually-hidden">Support links</h2>
<ul class="govuk-footer__inline-list govuk-!-display-none-print">
<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="<%= docs_path('/accessibility/index.html') %>">Accessibility</a></li>
<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="<%= docs_path('/community/licensing.html') %>">Licence</a></li>
<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="<%= docs_path('/sitemap.html') %>">Sitemap</a></li>
<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="<%= docs_path('/community/licensing.html') %>#cookies-and-site-information">Privacy and Cookies</a></li>
</ul>
<a class="govuk-footer__link" href="<%= docs_path('/community/licensing.html') %>"><img class="govuk-footer__licence-logo" src="<%= docs_path('/images/license-mit-88x31.svg') %>" alt="Some rights reserved" width="88" height="31"></a>
<span class="govuk-footer__licence-description">civica is free to use and share under the civica Free Use Licence, some rights reserved. civica is independent of the UK Government and uses open-source GOV.UK Frontend components; see <a class="govuk-footer__link" href="<%= docs_path('/community/licensing.html') %>">Licence and attribution</a>.</span>
</div>
<div class="govuk-footer__meta-item">
<a class="govuk-footer__link c-footer__brand" href="<%= docs_path('/index.html') %>"><img src="<%= docs_path('/images/civica-lockup-on-white.svg') %>" alt="civica" width="200" height="44"></a>
</div>
</div>
</div>
</footer>
