<% illustrated_page = !!page_illustration %>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#1d70b8">
<title><%= escape(az_page_title) %> – Civica Design System</title>
<meta name="description" content="<%= escape(current_page.data.description || 'A clear, consistent Home Assistant interface inspired by UK public service design.') %>">
<% if current_page.data.ai_instructions %>
<% if current_page.data.section == "content" %>
<meta name="ai-guide-context" content="This page is part of the Civica writing guide for Home Assistant. The guide has four parts that depend on each other: Writing guidelines (what to say), Formatting content (how to lay it out), Publish, update or retire (how content is checked, changed and removed) and Lexicons (A to Z General and A to Z Technical, for looking up single words). Apply the writing guidelines first, then formatting, then the lifecycle checks, and use the lexicons to settle individual words. Rules have IDs such as WG-031 and anchors such as #wg-031. Each rule is a statement, a reason and a Before and After pair. Write in British English. State only what Home Assistant has reported.">
<% else %>
<meta name="ai-guide-context" content="This page is part of the Civica Design System for Home Assistant. Pages state rules for dashboards, cards and controls, with examples that are documentation only and do not change a real device. Apply the page's own rules first, follow its related pages for anything it does not own, and use the Civica writing guide (content section) for wording. Write in British English. State only what Home Assistant has reported.">
<% end %>
<meta name="ai-instructions" content="<%= escape(current_page.data.ai_instructions) %>">
<% Array(current_page.data.ai_related).each do |related| %><meta name="ai-related" content="<%= escape(related['title']) %> (<%= escape(related['path']) %>): <%= escape(related['relationship']) %>">
<% end %>
<% end %>
<%= stylesheet_link_tag 'screen' %><%= favicon_tag 'favicon.ico' %>
<link rel="icon" type="image/svg+xml" href="<%= docs_path('/images/favicon.svg') %>"><link rel="apple-touch-icon" href="<%= docs_path('/images/apple-touch-icon.png') %>"><link rel="manifest" href="<%= docs_path('/site.webmanifest') %>">
</head>
<body class="<%= home_page? ? 'c-home' : 'c-guide' %>">
<a class="c-skip" href="#main-content">Skip to main content</a>
<%= site_notice %>
<%= javascript_include_tag 'site-notice' %>
<header class="c-header"><div class="c-container c-header__inner">
<a class="c-brand" href="<%= docs_path('/index.html') %>" aria-label="Civica Design System home"><img src="<%= docs_path('/images/civica-lockup.svg') %>" alt="Civica" width="236" height="52"><span class="c-header__name">Design System</span></a>
<form class="c-search" role="search" action="<%= docs_path('/search.html') %>"><label class="govuk-visually-hidden" for="site-search">Search Design System</label><input id="site-search" name="q" type="search" placeholder="Search Design System"><button type="submit" aria-label="Search"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15 15 6 6" stroke="currentColor" stroke-width="2"/></svg></button></form>
</div></header>
<nav class="c-navigation" aria-label="Main navigation"><div class="c-container"><button type="button" class="c-menu-toggle" aria-expanded="true" aria-controls="primary-navigation" hidden>Menu</button><ul id="primary-navigation">
<% data.navigation.sections.each do |section| %><li><a href="<%= docs_path(section.path) %>"<%= ' aria-current="true"' if current_section == section.id %>><%= section.title %></a></li><% end %>
</ul></div></nav>
<% if home_page? %>
<main id="main-content" class="c-home-content" tabindex="-1"><%= yield %></main>
<% else %>
<div class="c-container c-page<%= ' c-page--illustrated' if illustrated_page %>">
<%# Section navigation follows the GOV.UK Design System sub-navigation: a labelled nav, plain theme headings and lists, and a marked current item. %>
<nav class="app-subnav c-sidebar" aria-labelledby="app-subnav-heading">
<h2 class="govuk-visually-hidden" id="app-subnav-heading">Pages in this section</h2>
<% section = data.navigation.sections.find { |item| item.id == current_section } %>
<% if section && section.id == 'components' && !section.tree %><%# Components: one flat A to Z list of published parents from the locked inventory, named as the inventory names them, plus legacy pages until Branch 2 retires them. %>
<ul class="app-subnav__section">
<% component_sidebar_items.each do |item| %><% current = item['resource'].destination_path == current_page.destination_path %><li class="app-subnav__section-item<%= ' app-subnav__section-item--current' if current %>"><a class="app-subnav__link govuk-link govuk-link--no-visited-state govuk-link--no-underline" href="<%= docs_path('/' + item['resource'].destination_path) %>"<%= ' aria-current="page"' if current %>><%= escape(item['name']) %></a></li>
<% end %></ul>
<% elsif section && section.tree %><ul class="app-subnav__section app-subnav__tree">
<% here = page_home_path %><% section_tree(section.id).each do |entry| %><% on_overview = !entry[:group_link] && entry[:resource].destination_path == here %><% in_branch = on_overview || entry[:children].any? { |child| child.destination_path == here } %><li class="app-subnav__section-item<%= ' app-subnav__section-item--branch' if in_branch && entry[:children].any? %><%= ' app-subnav__section-item--current' if on_overview %>">
<a class="app-subnav__link govuk-link govuk-link--no-visited-state govuk-link--no-underline"<%= ' aria-current="page"' if on_overview %> href="<%= docs_path('/' + entry[:resource].destination_path) %>"><%= entry[:title] %></a>
<% if in_branch && entry[:children].any? %><ul class="app-subnav__children"><% entry[:children].each do |child| %><% child_here = child.destination_path == here %><li class="app-subnav__child<%= ' app-subnav__child--current' if child_here %>"><a class="app-subnav__link govuk-link govuk-link--no-visited-state govuk-link--no-underline"<%= ' aria-current="page"' if child_here %> href="<%= docs_path('/' + child.destination_path) %>"><%= child.data.title %></a></li><% end %></ul><% end %></li><% end %></ul>
<% elsif section %><% section_groups(section.id).each do |group, resources| %>
<h3 class="app-subnav__theme"><%= group %></h3>
<ul class="app-subnav__section">
<% resources.each do |resource| %><% current = resource.destination_path == current_page.destination_path %><li class="app-subnav__section-item<%= ' app-subnav__section-item--current' if current %>"><a class="app-subnav__link govuk-link govuk-link--no-visited-state govuk-link--no-underline" href="<%= docs_path('/' + resource.destination_path) %>"<%= ' aria-current="page"' if current %>><%= escape(resource.data.title) %></a></li><% end %>
</ul><% end %>
<% else %><ul class="app-subnav__section"><% data.navigation.sections.each do |item| %><li class="app-subnav__section-item"><a class="app-subnav__link govuk-link govuk-link--no-visited-state govuk-link--no-underline" href="<%= docs_path(item.path) %>"><%= item.title %></a></li><% end %></ul><% end %>
</nav>
<main class="technical-documentation c-content<%= ' c-content--illustrated' if illustrated_page %>" id="main-content" tabindex="-1">
<% if illustrated_page %><%= yield_content :illustrated_header %><div class="c-reading-content"><% else %><%= partial 'partials/breadcrumbs' %><% end %>
<%= yield %>
<%= partial 'partials/component_family' %>
<%= partial 'partials/history' %>
<%= partial 'partials/share_links' %>
<%= '</div>' if illustrated_page %>
</main></div><% end %>
<%= partial 'partials/page_feedback' %>
<%= partial 'partials/footer' %>
<%= javascript_include_tag 'civica-docs', defer: true %>
</body></html>
