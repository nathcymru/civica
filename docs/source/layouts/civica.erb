<%
  fragment = Nokogiri::HTML::DocumentFragment.parse(yield)
  headings = fragment.children.select { |node| node.name == 'h2' }
  # Component pages lead with the default rendered example, as the official
  # Design System does; supporting variants remain beside their guidance.
  first_example = fragment.at_css('.c-example')
  if current_section == 'components' && first_example && headings.first
    prior = first_example.previous_element
    while prior && !%w[h2 h3].include?(prior.name)
      prior = prior.previous_element
    end
    if prior && %w[h2 h3].include?(prior.name)
      reference = Nokogiri::XML::Node.new('p', fragment.document)
      link = Nokogiri::XML::Node.new('a', fragment.document)
      link['href'] = "##{first_example['id']}"
      link.content = 'View this example at the start of the page'
      reference.add_child(link)
      first_example.add_previous_sibling(reference)
    end
    first_example.unlink
    headings.first.add_previous_sibling(first_example)
  end
  # No "On this page" box: it was removed from every page on
  # 18 November 2026. Headings
  # keep the ids the box used to give them, so existing #section-N links work.
  if headings.length >= 3 && !home_page?
    headings.each_with_index { |heading, index| heading['id'] ||= "section-#{index + 1}" }
  end
  table_labels = Hash.new(0)
  fragment.css('table').each do |table|
    heading = table.xpath('preceding::*[self::h2 or self::h3][1]').first
    disclosure = table.ancestors('details').first
    summary = disclosure&.at_xpath('./summary')
    caption = table.at_xpath('./caption')
    label = [heading&.text || current_page.data.title, summary&.text, caption&.text].compact.map(&:strip).reject(&:empty?).uniq.join(' — ')
    table_labels[label] += 1
    label = "#{label} (#{table_labels[label]})" if table_labels[label] > 1
    wrapper = Nokogiri::XML::Node.new('div', fragment.document)
    wrapper['class'] = 'c-table-region'
    wrapper['role'] = 'region'
    wrapper['tabindex'] = '0'
    wrapper['aria-label'] = "#{label} table"
    table.replace(wrapper)
    wrapper.add_child(table)
  end
  # A sub-page names its section above the heading, as the reference guidance
  # does, so the heading never stands alone. Overviews and hero pages do not.
  if (heading = fragment.at_css('h1')) && !page_illustration && current_section &&
     (tree_section = data.navigation.sections.find { |item| item.id == current_section }) && tree_section.tree
    parent = section_tree(current_section).find do |entry|
      entry[:children].any? { |child| child.destination_path == current_page.destination_path } &&
        (entry[:group_link] || entry[:resource].destination_path != current_page.destination_path)
    end
    if parent
      caption = Nokogiri::XML::Node.new('p', fragment.document)
      caption['class'] = 'c-caption'
      caption.content = parent[:title]
      heading.add_previous_sibling(caption)
    end
  end
  # The title, lead and original art form one wide hero, as in the source
  # guidance. Keep the breadcrumb in that panel and all copy as real HTML.
  illustration = page_illustration
  if illustration && (heading = fragment.at_css('h1'))
    header = Nokogiri::XML::Node.new('header', fragment.document)
    header['class'] = 'c-illustrated-header'
    # Each hero has its own palette colour: a dark panel for the text and a pale
    # panel for the art, as in the reference site. Blue keeps the base artwork.
    family = illustration['colour']
    if family
      dark, light = hero_colours(family)
      header['style'] = "--hero-dark:#{dark};--hero-light:#{light}"
    end
    text_panel = Nokogiri::XML::Node.new('div', fragment.document)
    text_panel['class'] = 'c-illustrated-header__text'
    text_panel.add_child(partial('partials/breadcrumbs'))
    text_panel.add_child(heading.unlink)
    summary = Nokogiri::XML::Node.new('p', fragment.document)
    summary['class'] = 'c-illustrated-header__summary'
    summary.content = illustration['summary']
    text_panel.add_child(summary)
    header.add_child(text_panel)
    art_panel = Nokogiri::XML::Node.new('div', fragment.document)
    art_panel['class'] = 'c-illustrated-header__art'
    artwork = Nokogiri::XML::Node.new('img', fragment.document)
    asset = (family && family != 'blue') ? "hero/#{family}-#{illustration['asset']}" : illustration['asset']
    artwork['src'] = docs_path('/images/' + asset)
    artwork['alt'] = ''
    artwork['width'] = '640'
    artwork['height'] = '480'
    artwork['decoding'] = 'async'
    art_panel.add_child(artwork)
    header.add_child(art_panel)
    content_for :illustrated_header do
      header.to_html
    end
  end
  if current_page.data.repository_source == 'LICENSE.md'
    # Keep the repository-rendered terms distinct from examples and page history.
    licence = Nokogiri::XML::Node.new('div', fragment.document)
    licence['data-license-content'] = ''
    licence['data-source-sha256'] = Digest::SHA256.file(File.expand_path('../LICENSE.md', root)).hexdigest
    nodes = fragment.children.take_while { |node| !(node.name == 'h2' && node.text == 'Examples') }
    fragment.children.first.add_previous_sibling(licence)
    nodes.each { |node| licence.add_child(node.unlink) }
  end
  content = fragment.to_html
  content_for :page_contents do
    single_page_table_of_contents(content, max_level: 2)
  end
  wrap_layout :civica_core do
    content
  end
%>
